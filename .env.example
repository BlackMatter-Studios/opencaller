# ==========================================
# OpenCaller Environment Configuration
# ==========================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
NODE_DOMAIN=opencaller.blackmatter.cc

# PostgreSQL Connection (Tuned for < 120MB RAM)
DATABASE_URL=postgres://opencaller:opencaller_secure_password@postgres:5432/opencaller

# Security & JWT Authentication
JWT_SECRET=replace_this_with_a_64_char_random_hex_key_for_production
JWT_EXPIRATION_HOURS=720

# Node Federation & Cryptography (Ed25519)
NODE_PRIVATE_KEY=
NODE_PUBLIC_KEY=

# Community Caller ID & Privacy Safeguards
MIN_CONSENSUS_REPORTS=3
SPAM_BLOCK_THRESHOLD=0.80

# Ingestion Crawler Daemon
CRAWLER_INTERVAL_SECS=3600
ENABLE_OSINT_CRAWLER=true

# Cloudflare Ingress Tunnel
# Get this from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiZXhhbXBsZXRva2VuMSIsInQiOiJleGFtcGxldG9rZW4yIiwicyI6ImV4YW1wbGV0b2tlbjMifQ==

# Telegram Bot Verification Gateway
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=OpenCallerVerifyBot

# WhatsApp Baileys Self-Hosted Bridge
WHATSAPP_PORT=8766
WHATSAPP_ENCRYPTION_KEY=change_me_to_32_bytes_random_secret_for_creds
WHATSAPP_BRIDGE_TOKEN=change_me_to_secure_bridge_token
WHATSAPP_PAIR_TOKEN=change_me_to_pairing_url_token
WHATSAPP_BRIDGE_SECRET=change_me_to_webhook_secret

# Android Play Integrity API (Hardware Attestation)
PLAY_INTEGRITY_ENABLED=false
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
ANDROID_PACKAGE_NAME=cc.blackmatter.opencaller

# Apple App Attest / DeviceCheck (iOS Hardware Attestation)
APPLE_APP_ATTEST_ENABLED=false
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=cc.blackmatter.opencaller
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_P8=

# Logging Level (RUST_LOG syntax)
RUST_LOG=info,opencaller_api=debug,opencaller_crawler=debug

