# ==========================================
# OpenCaller Environment Configuration
# ==========================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
NODE_DOMAIN=opencaller.blackmatter.cc

# PostgreSQL Connection (Tuned for < 120MB RAM)
DATABASE_URL=postgres://opencaller:opencaller_secure_password@postgres:5432/opencaller

# Security & JWT Authentication
JWT_SECRET=replace_this_with_a_64_char_random_hex_key_for_production
JWT_EXPIRATION_HOURS=720

# Node Federation & Cryptography (Ed25519)
NODE_PRIVATE_KEY=
NODE_PUBLIC_KEY=

# Community Caller ID & Privacy Safeguards
MIN_CONSENSUS_REPORTS=3
SPAM_BLOCK_THRESHOLD=0.80

# Ingestion Crawler Daemon
CRAWLER_INTERVAL_SECS=3600
ENABLE_OSINT_CRAWLER=true

# Cloudflare Ingress Tunnel
# Get this from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiZXhhbXBsZXRva2VuMSIsInQiOiJleGFtcGxldG9rZW4yIiwicyI6ImV4YW1wbGV0b2tlbjMifQ==

# Logging Level (RUST_LOG syntax)
RUST_LOG=info,opencaller_api=debug,opencaller_crawler=debug
