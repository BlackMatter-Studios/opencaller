# WhatsApp Baileys bridge — dedicated Postgres, single WhatsApp account.
PORT=8766
DATABASE_URL=postgres://mb_baileys:CHANGE_ME@postgres:5432/mb_baileys
WHATSAPP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_RANDOM_STRING
BRIDGE_AUTH_TOKEN=CHANGE_ME_BRIDGE_TOKEN
# Scoped-down token for the human-facing pairing link only (grants /pair, /qr,
# /status — never /send). This is the token to put in the link sent to a
# client for onboarding, so a leaked link can't be used to send WhatsApp
# messages from their number. Falls back to BRIDGE_AUTH_TOKEN if left unset.
PAIR_TOKEN=CHANGE_ME_PAIR_TOKEN
AUTH_DIR=/data/auth
HEALTH_FILE=/tmp/healthy
MIN_SEND_INTERVAL_MS=1100
PAIRING_TIMEOUT_MS=300000

# Simulated human response timing (see baileysService.ts) — a "reading" pause
# before the typing indicator turns on, then a typing-speed pause sized to the
# reply's length before it actually sends. Defaults below feel natural for
# Spanish chat-length replies; tune without a redeploy if it feels off.
MIN_READ_DELAY_MS=400
MAX_READ_DELAY_MS=1500
TYPING_MS_PER_CHAR=35
MIN_TYPING_DELAY_MS=800
MAX_TYPING_DELAY_MS=6000

# Where the existing Python agent's webhook is reachable from this bridge.
MB_PY_WEBHOOK_URL=http://host.docker.internal:8765/webhook/whatsapp-baileys
MB_PY_WEBHOOK_SECRET=CHANGE_ME_SHARED_SECRET

# Comma-separated E.164 numbers. When set, only these senders get relayed to
# the agent — everyone else is silently ignored. Use this while piloting on a
# personal WhatsApp account so it doesn't auto-reply to real contacts. Leave
# empty (or unset) once this is a dedicated business number.
BAILEYS_ALLOWED_PHONES=

# When true, the socket connects and can be paired/QR'd normally but never
# relays inbound messages to the agent and never sends a reply. Use this to
# hold a freshly-paired number in standby until ops is ready to go live.
BAILEYS_STANDBY=false
